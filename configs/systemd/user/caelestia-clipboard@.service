[Unit]
Description=Caelestia clipboard history (%i)
PartOf=caelestia-shell.service
After=caelestia-shell.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/wl-paste --type %i --watch /usr/bin/cliphist store
Restart=on-failure
RestartSec=1
StandardOutput=null

[Install]
WantedBy=caelestia-shell.service
