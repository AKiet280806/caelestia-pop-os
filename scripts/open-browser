#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail
profile="${XDG_CONFIG_HOME:-$HOME/.config}/caelestia-pop-os/profile.env"
if [[ -f $profile ]]; then
    # shellcheck source=/dev/null
    source "$profile"
fi
# Optional override is a single executable name/path, never evaluated as shell.
if [[ -n ${CAELESTIA_BROWSER:-} ]]; then exec "$CAELESTIA_BROWSER" "${@:-about:blank}"; fi
exec xdg-open "${1:-https://example.org}"
