#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail
[[ ${XDG_CURRENT_DESKTOP:-} == Hyprland && -n ${HYPRLAND_INSTANCE_SIGNATURE:-} && -n ${WAYLAND_DISPLAY:-} ]] || {
    printf '%s\n' 'Caelestia services may only start from the active Hyprland session.' >&2
    exit 1
}
profile="${XDG_CONFIG_HOME:-$HOME/.config}/caelestia-pop-os/profile.env"
if [[ -f $profile ]]; then
    # shellcheck source=/dev/null
    source "$profile"
fi
export CAELESTIA_AI_USAGE="${CAELESTIA_AI_USAGE:-${CAELESTIA_CODEX_USAGE:-0}}"
export CAELESTIA_CODEX_USAGE="${CAELESTIA_CODEX_USAGE:-0}" CAELESTIA_VIETNAMESE="${CAELESTIA_VIETNAMESE:-0}"
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
environment=(CAELESTIA_AI_USAGE CAELESTIA_CODEX_USAGE CAELESTIA_VIETNAMESE WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE HYPRLAND_INSTANCE_SIGNATURE PATH)
for name in DISPLAY XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME GTK_IM_MODULE QT_IM_MODULE XMODIFIERS; do
    [[ -v $name ]] && environment+=("$name")
done
dbus-update-activation-environment --systemd "${environment[@]}"
systemctl --user daemon-reload
# A per-desktop portals file chooses hyprland/gtk without global service masks.
systemctl --user restart xdg-desktop-portal.service
systemctl --user start caelestia-shell.service
systemctl --user start caelestia-clipboard@text.service caelestia-clipboard@image.service

for agent in /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 \
    /usr/libexec/polkit-gnome-authentication-agent-1; do
    if [[ -x $agent ]]; then
        if ! systemctl --user is-active --quiet caelestia-polkit.service; then
            systemd-run --user --unit=caelestia-polkit --collect \
                --property=PartOf=caelestia-shell.service --property=Restart=on-failure "$agent"
        fi
        break
    fi
done
if [[ ${CAELESTIA_VIETNAMESE:-0} == 1 ]]; then
    "$HOME/.local/bin/start-fcitx-unikey"
fi
if [[ ${CAELESTIA_AI_USAGE:-${CAELESTIA_CODEX_USAGE:-0}} == 1 ]]; then
    systemctl --user start caelestia-codex-usage.service
fi
